<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valentinstag</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: white;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            text-align: center;
        }

        .title {
            font-size: 28px;
            margin-bottom: 30px;
            color: #333;
        }

        .gallery {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .gallery img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 10px;
        }

        .buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-bottom: 40px;
        }

        button {
            padding: 12px 30px;
            font-size: 18px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .yes-btn {
            background-color: #ff69b4;
            color: white;
        }

        .no-btn {
            background-color: #ccc;
            color: #333;
        }

        .yes-btn:hover {
            background-color: #ff1493;
        }

        .no-btn:hover {
            background-color: #999;
        }

        .result {
            display: none;
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .result img {
            width: 200px;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 20px;
        }

        .result-text {
            font-size: 32px;
            color: #ff69b4;
            font-weight: bold;
        }

        .hearts {
            font-size: 40px;
            animation: float 1s ease-in-out infinite;
            display: inline-block;
            margin: 0 5px;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        @media (max-width: 600px) {
            .title {
                font-size: 22px;
            }

            .gallery img {
                width: 80px;
                height: 80px;
            }

            button {
                padding: 10px 20px;
                font-size: 16px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="title">Willst du mein Valentinsdate sein
            meine Raucherin? 💘
        </div>
        
        <div class="gallery">
            <img src="bilder/foto1.jpg.JPEG" alt="Foto 1" id="foto1">
            <img src="bilder/foto2.jpg.JPEG" alt="Foto 2" id="foto2">
            <img src="bilder/foto3.jpg.PNG" alt="Foto 3" id="foto3" style="display: none;" onclick="vergroessereBild(this)">
        </div>

        <div class="buttons">
            <button class="yes-btn" onclick="handleYes()">Ja</button>
            <button class="no-btn" onclick="handleNo()">Nein</button>
        </div>

        <div class="result" id="result">
            <img src="bilder/ja.jpg.JPEG" alt="Erfolg">
            <div class="result-text">
                Jaa! <span class="hearts">❤️</span><span class="hearts">❤️</span><span class="hearts">❤️</span>
            </div>
        </div>
    </div>

    <script>
        let noClickCount = 0;
        let bildScale = 1;
        const yesBtn = document.querySelector('.yes-btn');
        const noBtn = document.querySelector('.no-btn');

        function handleYes() {
            document.querySelector('.buttons').style.display = 'none';
            document.getElementById('result').style.display = 'block';
            createHearts();
        }

        function handleNo() {
            noClickCount++;
            if (noClickCount === 1) {
                document.getElementById('foto1').style.display = 'none';
                document.getElementById('foto2').style.display = 'none';
                document.getElementById('foto3').style.display = 'block';
            }
            if (noClickCount >= 1) {
                bildScale += 0.2;
                document.getElementById('foto3').style.transform = `scale(${bildScale})`;
            }
            let newSize = 12 + (noClickCount * 8);
            yesBtn.style.padding = (12 + noClickCount * 5) + 'px ' + (30 + noClickCount * 10) + 'px';
            yesBtn.style.fontSize = newSize + 'px';
        }

        function vergroessereBild(img) {
            let scale = parseFloat(img.dataset.scale || 1);
            scale += 0.2;
            img.style.transform = `scale(${scale})`;
            img.dataset.scale = scale;
        }

        function createHearts() {
            for (let i = 0; i < 20; i++) {
                setTimeout(() => {
                    const heart = document.createElement('div');
                    heart.innerHTML = '❤️';
                    heart.style.position = 'fixed';
                    heart.style.left = Math.random() * 100 + '%';
                    heart.style.top = '-30px';
                    heart.style.fontSize = '24px';
                    heart.style.animation = 'fall 3s ease-in forwards';
                    heart.style.pointerEvents = 'none';
                    document.body.appendChild(heart);
                    
                    setTimeout(() => heart.remove(), 3000);
                }, i * 100);
            }
        }

        const style = document.createElement('style');
        style.textContent = `
            @keyframes fall {
                to {
                    transform: translateY(100vh) rotate(360deg);
                    opacity: 0;
                }
            }
        `;
        document.head.appendChild(style);
    </script>
</body>
</html>
